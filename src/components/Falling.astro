---
// The letters of "panic" fall out of the logo (the first beat of the hero:
// you panic, everything falls apart). The shapes, the five letters and the
// dot of the "i", are read from src/assets/logo.svg at build time, so they
// always match the logo.
//
// The motion was converted keyframe by keyframe from the former Lottie
// animation (falling.json, 30 fps): the same paths, rotations and easing per
// step, played 1.3x faster. The fall ends at 2.33 s. Hero.astro owns the rest
// of the timeline (the fades) and the rules for when the letters show at all.
import logo from "../assets/logo.svg?raw";

/** The opening tag of the logo element with this id or Inkscape label. */
function element(tag: string, key: string, value: string) {
	const found = logo.match(
		new RegExp(`<${tag}\\b[^>]*\\s${key}="${value}"[^>]*>`),
	)?.[0];
	if (!found) throw new Error(`<${tag} ${key}="${value}"> not found in logo.svg`);
	return (name: string) =>
		found.match(new RegExp(`\\s${name}="([^"]*)"`))?.[1];
}

// The pivot of each shape in logo units, the point it moves and turns
// around, taken from the Lottie's first keyframe.
const letters = (
	[
		["p", 13.28, 27.885],
		["a", 34.69, 24.239],
		["n", 58.69, 24.135],
		["i", 76.005, 24.25],
		["c", 91.568, 24.198],
	] as const
).map(([label, x, y]) => {
	const attribute = element("path", "inkscape:label", label);
	return { label, x, y, d: attribute("d"), transform: attribute("transform") };
});

const dotAttribute = element("circle", "id", "path3");
const dot = {
	x: 76.104,
	y: 9.258,
	cx: dotAttribute("cx"),
	cy: dotAttribute("cy"),
	r: dotAttribute("r"),
	style: dotAttribute("style"),
};
---

<svg
	class="falling"
	viewBox="-0.99 3.59 105.83 105.83"
	preserveAspectRatio="xMidYMax meet"
	aria-hidden="true"
	focusable="false"
>
	{
		letters.map(({ label, x, y, d, transform }) => (
			<g transform={`translate(${x} ${y})`}>
				<g class={`shape letter-${label}`}>
					<g transform={`translate(${-x} ${-y})`}>
						<path d={d} transform={transform} />
					</g>
				</g>
			</g>
		))
	}
	<g transform={`translate(${dot.x} ${dot.y})`}>
		<g class="shape letter-dot">
			<g transform={`translate(${-dot.x} ${-dot.y})`}>
				<circle cx={dot.cx} cy={dot.cy} r={dot.r} style={dot.style} />
			</g>
		</g>
	</g>
</svg>

