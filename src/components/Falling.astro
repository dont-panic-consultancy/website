		display: block;
		width: 100%;
		height: 100%;
		overflow: hidden;
		pointer-events: none;
	}

	.shape {
		transform-origin: 0 0;
		animation-duration: 2.333s;
		animation-fill-mode: both;
	}

	/* A letter runs two animations, one for its path and one for its
	   rotation, because their keyframes fall on different frames. */
	.letter-p { animation-name: fall-p-move, fall-p-turn; }
	.letter-a { animation-name: fall-a-move, fall-a-turn; }
	.letter-n { animation-name: fall-n-move, fall-n-turn; }
	.letter-i { animation-name: fall-i-move, fall-i-turn; }
	.letter-c { animation-name: fall-c-move, fall-c-turn; }

	/* The dot of the "i" shakes with the letters, then rolls down a smooth
	   path through the Lottie's stops at an even pace, and lands at 3.3 s.
	   Its keyframes are samples of that path, so they are joined linearly. */
	.letter-dot {
